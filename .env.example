# Copy this file to .env and fill in real values. Never commit .env.
# Supabase (public) — required for the client-side app to talk to Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side secrets must NOT be placed in this file — use a server-side
# endpoint / server environment variables (e.g. Netlify Functions).
# VITE_OPENAI_PROXY_URL=http://localhost:3000/.netlify/functions/openai