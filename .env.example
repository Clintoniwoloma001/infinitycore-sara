# Copy this file to .env and fill in real values. Never commit .env.
# Supabase (public) — required for the client-side app to talk to Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Canonical application URL used by client auth redirects. Set this to the
# Vercel production URL in Vercel; leave unset locally to use localhost:5173.
VITE_APP_URL=https://infinitymfbcore.vercel.app

# Supabase Edge Function configuration (non-secret). Set APP_URL in the
# function environment so privileged invitation links use the same domain.
# For local Edge Functions, override it with http://localhost:5173.
APP_URL=https://infinitymfbcore.vercel.app

# Server-side secrets must NOT be placed in this file — use a server-side
# endpoint / server environment variables (e.g. Netlify Functions).
# VITE_OPENAI_PROXY_URL=http://localhost:3000/.netlify/functions/openai
