# Copy this file to .env and fill in real values. Never commit .env.
# Supabase (public) — required for the client-side app to talk to Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Canonical application URL used by client auth redirects. Set this to the
# Vercel production URL in Vercel; leave unset locally to use localhost:5173.
VITE_APP_URL=https://infinitymfbcore.vercel.app

# Supabase Edge Function configuration (non-secret). Set APP_URL in the
# function environment so privileged invitation links use the same domain.
# For local Edge Functions, override it with http://localhost:5173.
APP_URL=https://infinitymfbcore.vercel.app

# Server-side secrets must NOT be placed in this file — use a server-side
# endpoint / server environment variables (e.g. Netlify Functions).
# VITE_OPENAI_PROXY_URL=http://localhost:3000/.netlify/functions/openai

# --- SARA → local Jarvis (OpenAI-compatible), local dev only ---
# The browser NEVER talks to Jarvis directly. Web SARA calls go through the
# Supabase Edge Functions, whose router (supabase/functions/_shared/aiRouter.ts)
# reads these from SERVER-SIDE function secrets:
#   supabase/functions/.env.local  (for `supabase functions serve`), or
#   `supabase secrets set` on hosted.
# No VITE_ prefix here on purpose — Vite only bundles VITE_* into client JS,
# so the AUTH_TOKEN can never leak into the browser bundle. OPENAI_API_KEY
# itself lives ONLY in supabase/functions/.env.local (git-ignored), never here.
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_MODEL=Jarvis
